# ─── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/iunlockd
SESSION_SECRET=change-this-to-a-long-random-secret

# ─── API Server ─────────────────────────────────────────────────────────────
# Port the Express API listens on (default: 5000)
PORT=5000
NODE_ENV=production

# ─── Frontend (Vite dev/preview only) ───────────────────────────────────────
# PORT defaults to 3000, BASE_PATH defaults to /
# PORT=3000
# BASE_PATH=/

# ─── Email / OTP (optional) ──────────────────────────────────────────────────
# If not set, OTP codes are only printed to server console (dev mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@iunlockd.com
