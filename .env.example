# ═══════════════════════════════════════════════════════════════
#  iUnlockd — Environment Variables Reference
#  Copy this file to .env on your VPS and fill in the values.
#  Never commit your real .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/iunlockd
SESSION_SECRET=change-this-to-a-long-random-secret-min-32-chars
NODE_ENV=production

# ─── API Server ─────────────────────────────────────────────────
PORT=5000

# ─── Email / OTP (SMTP) ─────────────────────────────────────────
# Required for email verification and password reset to work.
# Without SMTP, OTP codes are printed to server logs only (dev mode).
#
# Port 465  → SSL   (secure=true)  — most providers
# Port 587  → STARTTLS (secure=false) — Gmail, Outlook etc.
# Port 25   → plain (avoid — often blocked by VPS providers)
#
SMTP_HOST=mail.iunlockd.com
SMTP_PORT=465
SMTP_USER=noreply@iunlockd.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@iunlockd.com

# ─── Crypto / USDT Auto-Deposit ─────────────────────────────────
# USDT wallet address on opBNB chain
WALLET_OPBNB=0xYourOpBNBWalletAddress

# USDT wallet address on Plasma chain
WALLET_PLASMA=0xYourPlasmaWalletAddress

# ─── Merchant API (optional) ────────────────────────────────────
# If set, services will sync from this API every 6 hours automatically.
# Manual sync available via Admin → Services → "Sync from Merchant API" button.
#
# MERCHANT_API_ENDPOINT — base URL of merchant's API (no trailing slash)
#   e.g. https://api.yourmerchant.com/v1
# MERCHANT_API_KEY — Bearer token / API key for authentication
# MERCHANT_API_USER — optional partner/user ID sent as X-Partner-ID header
#
MERCHANT_API_ENDPOINT=
MERCHANT_API_KEY=
MERCHANT_API_USER=
